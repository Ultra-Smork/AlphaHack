# App
APP_ENV=development
HTTP_ADDR=:8000

# Database
DATABASE_URL=sqlite:///./alphahack.db
DROP_ON_START=false

# Auth
JWT_SECRET=dev-insecure-change-me
JWT_TTL=24h

# ML service
ML_MODE=mock
ML_BASE_URL=http://localhost:8001

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (Vite reads this same file through envDir)
VITE_API_URL=http://localhost:8000

# AI assistant (OpenAI-compatible). Leave AI_MOCK=true to run fully offline.
AI_MOCK=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
