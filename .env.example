# App
APP_ENV=development
HTTP_ADDR=:8080

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/alphahack?sslmode=disable

# Auth
JWT_SECRET=dev-insecure-change-me
JWT_TTL=24h

# AI assistant (OpenAI-compatible). Leave AI_MOCK=true to run fully offline.
AI_MOCK=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
